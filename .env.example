# ==============================================================================
# Synterview Environment Configuration
# ==============================================================================
# In "offline mock mode", ZERO paid API keys are required. All features run
# with local/mock adapters.
# Switch to "live mode" by providing provider credentials and setting the
# corresponding PROVIDER flags.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core App & Database
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
# PostgreSQL Connection String (Neon, Supabase, or local Docker postgres)
# Provide this when switching from offline mock mode to live persistent database mode:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/synterview

# ------------------------------------------------------------------------------
# 2. Authentication (Dual-Token JWT)
# ------------------------------------------------------------------------------
# In production, generate secure 256-bit secrets: `openssl rand -base64 32`
JWT_ACCESS_SECRET=synterview-super-secret-access-key-minimum-32-chars-length
JWT_REFRESH_SECRET=synterview-super-secret-refresh-key-minimum-32-chars-length
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 3. Question Planner (Prep Phase)
# ------------------------------------------------------------------------------
# Options:
#   - "mock"    : Offline heuristic planner (zero models or keys needed)
#   - "local"   : Local LLM (Ollama, LM Studio, vLLM via OpenAI-compatible endpoint)
#   - "gemini"  : Google Gemini API
PLANNER_PROVIDER=mock

# For Gemini API:
GEMINI_API_KEY=

# For Local LLM (Ollama / LM Studio):
LOCAL_LLM_URL=http://localhost:11434/v1/chat/completions
LOCAL_LLM_MODEL=llama3.2

# ------------------------------------------------------------------------------
# 4. Voice Interview Engine (Live Phase)
# ------------------------------------------------------------------------------
# Options: "mock" (offline browser Web Speech API & mock turn taker) | "livekit" (LiveKit Cloud/Self-hosted)
VOICE_PROVIDER=mock

# LiveKit Credentials (Required only if VOICE_PROVIDER=livekit)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ------------------------------------------------------------------------------
# 5. Speech Confidence & Tone Analysis Model (Swappable Module)
# ------------------------------------------------------------------------------
# Options: "mock" (local acoustic & lexical heuristic analyzer) | "local" (custom local PyTorch/ONNX service)
SPEECH_ANALYZER_PROVIDER=mock
# URL of your locally running Python ML service (e.g., FastAPI running custom PyTorch/wav2vec2/whisper model)
LOCAL_SPEECH_MODEL_URL=http://localhost:8000/analyze-tone
